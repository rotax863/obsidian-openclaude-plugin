{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    "noEmit": true,
    "incremental": false,
    "types": ["jest"],
    "moduleResolution": "node",
    "inlineSourceMap": false,
    "sourceMap": false,
    "inlineSources": false,
    "paths": {
      "@/main": ["./src/main"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.test.ts"]
}